generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FarmRole {
  OWNER
  MANAGER
}

enum TenureType {
  TITLE
  CUSTOMARY_CERTIFICATE
  LEASE
  INFORMAL
}

enum DocumentStatus {
  NONE
  COPIED
  VERIFIED
}

enum CropMode {
  NURSERY
  DIRECT
}

enum CycleStatus {
  PLANNED
  NURSERY
  TRANSPLANTED
  GROWING
  HARVESTING
  CLOSED
}

enum TaskStatus {
  PENDING
  DONE
  SKIPPED
  DELAYED
}

enum FigureLabel {
  PLACEHOLDER_BENCHMARK
  BENCHMARK
  LOCAL_QUOTE
  YOUR_ACTUAL
}

enum PlanScenario {
  EXPECTED
  LOW_PRICE
  LOW_YIELD
}

enum ExpenseCategory {
  SEED
  LAND_PREP
  NURSERY
  TRANSPLANTING
  IRRIGATION
  FERTILIZER
  WEEDING
  LABOUR
  MACHINERY
  HARVEST
  PACKAGING
  TRANSPORT
  OTHER
}

enum StockMovementType {
  PURCHASE
  USAGE
  ADJUSTMENT
}

enum DataRequestType {
  EXPORT
  DELETION
}

enum DataRequestStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  locale       String       @default("en")
  createdAt    DateTime     @default(now())
  memberships  FarmMember[]
  sessions     Session[]
  workEntries  WorkEntry[]
  activityLogs ActivityLog[]
  consents     ConsentRecord[]
  dataRequests DataRequest[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Farm {
  id        String   @id @default(cuid())
  name      String
  region    String?
  district  String?
  currency  String   @default("TZS")
  createdAt DateTime @default(now())

  members        FarmMember[]
  landHoldings   LandHolding[]
  plots          Plot[]
  cropTypes      CropType[]
  cropCycles     CropCycle[]
  workers        Worker[]
  expenses       Expense[]
  activityLogs   ActivityLog[]
  defaultWageTzs Decimal? @db.Decimal(12, 2)
  stockItems     StockItem[]
  suppliers      Supplier[]
  stockMovements StockMovement[]
  dataRequests   DataRequest[]
  consents       ConsentRecord[]
}

model FarmMember {
  id        String   @id @default(cuid())
  farmId    String
  userId    String
  role      FarmRole
  createdAt DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([farmId, userId])
  @@index([userId])
}

model LandHolding {
  id             String         @id @default(cuid())
  farmId         String
  name           String
  owned          Boolean        @default(true)
  costOrRent     Decimal?       @db.Decimal(14, 2)
  currency       String         @default("TZS")
  leaseStart     DateTime?
  leaseEnd       DateTime?
  ownerName      String?
  notes          String?
  createdAt      DateTime       @default(now())

  farm  Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plots Plot[]
}

model Plot {
  id             String         @id @default(cuid())
  farmId         String
  holdingId      String
  name           String
  areaValue      Decimal        @db.Decimal(12, 4)
  areaUnit       String         @default("acre")
  soilType       String?
  waterSource    String?
  gpsLat         Decimal?       @db.Decimal(10, 7)
  gpsLng         Decimal?       @db.Decimal(10, 7)
  tenureType     TenureType     @default(INFORMAL)
  documentStatus DocumentStatus @default(NONE)
  renewalDate    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())

  farm     Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  holding  LandHolding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  cycles   CropCycle[]
}

model CropType {
  id                 String     @id @default(cuid())
  farmId             String
  name               String
  varietyDefault     String?
  mode               CropMode
  cycleLengthDays    Int?
  spacingNote        String?
  plantsPerAcre      Decimal?   @db.Decimal(12, 2)
  yieldPerPlant      Decimal?   @db.Decimal(12, 4)
  yieldUnit          String     @default("kg")
  figureLabel        FigureLabel @default(PLACEHOLDER_BENCHMARK)
  createdAt          DateTime   @default(now())

  farm           Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  stageTemplates StageTemplate[]
  careTemplates  CareTemplate[]
  cycles         CropCycle[]
}

model StageTemplate {
  id         String @id @default(cuid())
  farmId     String
  cropTypeId String
  key        String
  nameEn     String
  nameSw     String
  sortOrder  Int
  dayOffset  Int?

  cropType CropType @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)
}

model CareTemplate {
  id              String @id @default(cuid())
  farmId          String
  cropTypeId      String
  taskType        String
  afterStageKey   String
  intervalDays    Int
  nameEn          String
  nameSw          String

  cropType CropType @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)
}

model CropCycle {
  id             String      @id @default(cuid())
  farmId         String
  plotId         String
  cropTypeId     String
  variety        String?
  areaValue      Decimal     @db.Decimal(12, 4)
  areaUnit       String      @default("acre")
  plantingAt     DateTime?
  status         CycleStatus @default(PLANNED)
  expectedYield  Decimal?    @db.Decimal(14, 4)
  actualYield    Decimal?    @db.Decimal(14, 4)
  yieldUnit      String      @default("kg")
  figureLabel    FigureLabel @default(PLACEHOLDER_BENCHMARK)
  createdAt      DateTime    @default(now())

  farm     Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plot     Plot          @relation(fields: [plotId], references: [id], onDelete: Cascade)
  cropType CropType      @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)
  batches  NurseryBatch[]
  tasks    Task[]
  logs     ActivityLog[]
  work     WorkEntry[]
  expenses Expense[]
  plans    CropPlan[]
  harvests Harvest[]
  sales    Sale[]
  stockMovements StockMovement[]

  @@index([farmId, status])
  @@index([plotId, cropTypeId])
}

model NurseryBatch {
  id           String   @id @default(cuid())
  farmId       String
  cycleId      String
  seedLot      String?
  variety      String?
  supplier     String?
  quantity     Decimal  @db.Decimal(14, 4)
  quantityUnit String   @default("g")
  costAmount   Decimal? @db.Decimal(14, 2)
  currency     String   @default("TZS")
  sownAt       DateTime?
  notes        String?
  createdAt    DateTime @default(now())

  cycle    CropCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  checks   NurseryCheck[]
  plants   Transplant[]
}

model NurseryCheck {
  id          String   @id @default(cuid())
  farmId      String
  batchId     String
  checkedAt   DateTime @default(now())
  germinated  Int?
  surviving   Int?
  condition   String?
  notes       String?

  batch NurseryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Transplant {
  id                String   @id @default(cuid())
  farmId            String
  batchId           String
  movedAt           DateTime @default(now())
  quantityMoved     Int
  quantityDiscarded Int      @default(0)
  reason            String?

  batch NurseryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Task {
  id          String     @id @default(cuid())
  farmId      String
  cycleId     String
  plotId      String?
  taskType    String
  titleEn     String
  titleSw     String
  dueAt       DateTime
  status      TaskStatus @default(PENDING)
  doneAt      DateTime?
  notes       String?
  createdAt   DateTime   @default(now())

  cycle CropCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@index([farmId, dueAt, status])
  @@index([cycleId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  farmId    String
  cycleId   String?
  userId    String?
  loggedAt  DateTime @default(now())
  weather   String?
  body      String
  whoWorked String?
  synced    Boolean  @default(true)

  farm  Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cycle CropCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Worker {
  id        String   @id @default(cuid())
  farmId    String
  name      String
  hourlyRate Decimal? @db.Decimal(12, 2)
  currency  String   @default("TZS")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  farm    Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  entries WorkEntry[]
}

model WorkEntry {
  id         String   @id @default(cuid())
  farmId     String
  workerId   String
  cycleId    String?
  userId     String?
  taskLabel  String
  startedAt  DateTime
  endedAt    DateTime
  hourlyRate Decimal  @db.Decimal(12, 2)
  amount     Decimal  @db.Decimal(14, 2)
  currency   String   @default("TZS")
  paid       Boolean  @default(false)
  createdAt  DateTime @default(now())

  worker Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  cycle  CropCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  user   User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([farmId, cycleId, startedAt])
}

model Expense {
  id         String          @id @default(cuid())
  farmId     String
  cycleId    String?
  category   ExpenseCategory
  amount     Decimal         @db.Decimal(14, 2)
  currency   String          @default("TZS")
  spentAt    DateTime        @default(now())
  notes      String?
  createdAt  DateTime        @default(now())

  farm  Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cycle CropCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([farmId, cycleId, category])
  @@index([spentAt])
}

model CropPlan {
  id              String       @id @default(cuid())
  farmId          String
  cycleId         String
  scenario        PlanScenario @default(EXPECTED)
  areaAcres       Decimal      @db.Decimal(12, 4)
  seedGrams       Decimal?     @db.Decimal(14, 4)
  seedsPerGram    Decimal?     @db.Decimal(14, 4)
  germinationRate Decimal?     @db.Decimal(6, 4)
  survivalRate    Decimal?     @db.Decimal(6, 4)
  plantsPerAcre   Decimal?     @db.Decimal(12, 2)
  yieldPerPlant   Decimal?     @db.Decimal(12, 4)
  yieldUnit       String       @default("kg")
  farmgatePrice   Decimal?     @db.Decimal(14, 2)
  harvestMonth    Int?
  currency        String       @default("TZS")
  figureLabel     FigureLabel  @default(PLACEHOLDER_BENCHMARK)
  notes           String?
  createdAt       DateTime     @default(now())

  cycle CropCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  lines CropPlanLine[]

  @@unique([cycleId, scenario])
}

model CropPlanLine {
  id          String          @id @default(cuid())
  farmId      String
  planId      String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(14, 2)
  currency    String          @default("TZS")
  timingMonth Int?
  figureLabel FigureLabel     @default(PLACEHOLDER_BENCHMARK)

  plan CropPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Harvest {
  id        String   @id @default(cuid())
  farmId    String
  cycleId   String
  harvestedAt DateTime @default(now())
  quantity  Decimal  @db.Decimal(14, 4)
  unit      String   @default("kg")
  grade     String?
  lossQty   Decimal? @db.Decimal(14, 4)
  notes     String?

  cycle CropCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([farmId, cycleId, harvestedAt])
}

model Sale {
  id        String   @id @default(cuid())
  farmId    String
  cycleId   String
  soldAt    DateTime @default(now())
  quantity  Decimal  @db.Decimal(14, 4)
  unit      String   @default("kg")
  price     Decimal  @db.Decimal(14, 2)
  currency  String   @default("TZS")
  buyer     String?
  notes     String?

  cycle CropCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([farmId, cycleId, soldAt])
}

model StockItem {
  id                String   @id @default(cuid())
  farmId            String
  name              String
  category          ExpenseCategory
  unit              String
  lowStockThreshold Decimal? @db.Decimal(14, 4)
  createdAt         DateTime @default(now())

  farm      Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@unique([farmId, name])
}

model Supplier {
  id        String   @id @default(cuid())
  farmId    String
  name      String
  contact   String?
  createdAt DateTime @default(now())

  farm      Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@unique([farmId, name])
}

model StockMovement {
  id           String            @id @default(cuid())
  farmId       String
  itemId       String
  supplierId   String?
  cycleId      String?
  taskId       String?
  type         StockMovementType
  quantity     Decimal           @db.Decimal(14, 4)
  unit         String
  unitCost     Decimal?          @db.Decimal(14, 4)
  currency     String            @default("TZS")
  lotReference String?
  movedAt      DateTime          @default(now())
  notes        String?

  farm     Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  item     StockItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  cycle    CropCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  task     Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([farmId, itemId, movedAt])
  @@index([farmId, cycleId, type])
}

model ConsentRecord {
  id            String   @id @default(cuid())
  farmId        String
  userId        String
  purpose       String
  policyVersion String
  granted       Boolean
  recordedAt    DateTime @default(now())
  withdrawnAt   DateTime?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([farmId, userId, purpose, recordedAt])
}

model DataRequest {
  id          String           @id @default(cuid())
  farmId      String
  userId      String
  type        DataRequestType
  status      DataRequestStatus @default(REQUESTED)
  requestedAt DateTime         @default(now())
  completedAt DateTime?
  notes       String?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([farmId, userId, status])
}
