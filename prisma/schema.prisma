generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FarmRole {
  OWNER
  MANAGER
}

enum TenureType {
  TITLE
  CUSTOMARY_CERTIFICATE
  LEASE
  INFORMAL
}

enum DocumentStatus {
  NONE
  COPIED
  VERIFIED
}

enum CropMode {
  NURSERY
  DIRECT
}

enum CropReferenceKind {
  DISEASE
  PESTICIDE
}

enum CycleStatus {
  PLANNED
  NURSERY
  TRANSPLANTED
  GROWING
  HARVESTING
  CLOSED
}

enum TaskStatus {
  PENDING
  DONE
  SKIPPED
  DELAYED
}

enum FigureLabel {
  PLACEHOLDER_BENCHMARK
  BENCHMARK
  LOCAL_QUOTE
  YOUR_ACTUAL
}

enum PlanScenario {
  EXPECTED
  LOW_PRICE
  LOW_YIELD
}

enum ExpenseCategory {
  SEED
  LAND_PREP
  NURSERY
  TRANSPLANTING
  IRRIGATION
  FERTILIZER
  WEEDING
  LABOUR
  MACHINERY
  HARVEST
  PACKAGING
  TRANSPORT
  FEED
  VETERINARY_MEDICINE
  OTHER
}

enum StockMovementType {
  PURCHASE
  USAGE
  ADJUSTMENT
}

enum AnimalEventType {
  BIRTH
  PURCHASE
  WEANING
  MOVE
  BREEDING
  SALE
  DEATH
  CULLED
  OTHER
}

enum AnimalDailyRecordType {
  FEEDING
  WATER
  MILK
  EGGS
  HEALTH_CHECK
  OTHER
}

enum AnimalTrackingMode {
  INDIVIDUAL
  HEAD_COUNT
}

enum AnimalHealthProductType {
  VACCINE
  MEDICINE
  OTHER
}

enum AnimalHealthRecordType {
  VACCINATION
  TREATMENT
  DEWORMING
  DIPPING
  TICK_CONTROL
  VET_VISIT
}

enum AnimalPerformanceType {
  WEIGHT
  MILK
  EGGS
}

enum AnimalPurpose {
  MILK
  MEAT
  EGGS
  DUAL
  BREEDING
  OTHER
}

enum AnimalTraitType {
  BIRTH_WEIGHT
  COLOR
  HORN_STATUS
  TEMPERAMENT
  CONFORMATION
  OTHER
}

enum AnimalBreedingMethod {
  NATURAL
  ARTIFICIAL_INSEMINATION
}

enum AnimalPregnancyResult {
  POSITIVE
  NEGATIVE
  INCONCLUSIVE
}

enum AnimalBirthOutcome {
  LIVE
  STILLBORN
  ABORTION
  UNKNOWN
}

enum AnimalProductLine {
  MILK
  MEAT
  EGGS
  LIVE_ANIMAL
  MANURE
  HIDES
  BREEDING_SERVICE
  OTHER
}

enum AssetDivision {
  CROPS
  ANIMALS
  SHARED
}

enum DataRequestType {
  EXPORT
  DELETION
}

enum DataRequestStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum DataRequestScope {
  FARM
  PERSON
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_MONEY
}

enum ScoutingSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AssetStatus {
  ACTIVE
  IDLE
  RETIRED
}

model User {
  id                    String           @id @default(cuid())
  email                 String           @unique
  name                  String
  passwordHash          String
  locale                String           @default("en")
  createdAt             DateTime         @default(now())
  memberships           FarmMember[]
  workEntries           WorkEntry[]
  activityLogs          ActivityLog[]
  consents              ConsentRecord[]
  dataRequests          DataRequest[]
  dataRequestsAsSubject DataRequest[]    @relation("DataRequestSubject")
  auditLogs             AuditLog[]       @relation("AuditActor")
  invitations           FarmInvitation[] @relation("InvitationCreator")
}

model Farm {
  id                    String   @id @default(cuid())
  name                  String
  region                String?
  district              String?
  currency              String   @default("TZS")
  areaUnit              String   @default("acre")
  totalAreaValue        Decimal? @db.Decimal(12, 4)
  totalAreaUnit         String   @default("acre")
  timezone              String   @default("Africa/Dar_es_Salaam")
  nationalFarmerId      String?
  animalDivisionEnabled Boolean  @default(false)
  createdAt             DateTime @default(now())

  members                    FarmMember[]
  landHoldings               LandHolding[]
  plots                      Plot[]
  cropTypes                  CropType[]
  cropReferences             CropReferenceItem[]
  cropCycles                 CropCycle[]
  workers                    Worker[]
  expenses                   Expense[]
  machineJobs                MachineJob[]
  assets                     Asset[]
  assetUsages                AssetUsage[]
  assetMaintenances          AssetMaintenance[]
  activityLogs               ActivityLog[]
  defaultWageTzs             Decimal?                    @db.Decimal(12, 2)
  stockItems                 StockItem[]
  suppliers                  Supplier[]
  stockMovements             StockMovement[]
  dataRequests               DataRequest[]
  consents                   ConsentRecord[]
  auditLogs                  AuditLog[]
  invitations                FarmInvitation[]
  disputes                   TenureDispute[]
  attachments                FileAttachment[]
  weatherLogs                WeatherLog[]
  scoutingLogs               ScoutingLog[]
  sprayRecords               SprayRecord[]
  subsidies                  SubsidyReceipt[]
  animals                    Animal[]
  animalGroups               AnimalGroup[]
  animalEvents               AnimalEvent[]
  animalDailyRecords         AnimalDailyRecord[]
  feedRations                FeedRation[]
  animalHealthProducts       AnimalHealthProduct[]
  animalVaccinationSchedules AnimalVaccinationSchedule[]
  animalHealthCases          AnimalHealthCase[]
  animalHealthRecords        AnimalHealthRecord[]
  animalPerformanceRecords   AnimalPerformanceRecord[]
  animalSpeciesProfiles      AnimalSpeciesProfile[]
  animalBreeds               AnimalBreed[]
  animalBreedBenchmarks      AnimalBreedBenchmark[]
  animalTraitRecords         AnimalTraitRecord[]
  animalBreedingRecords      AnimalBreedingRecord[]
  animalSales                AnimalSale[]
  animalSalePayments         AnimalSalePayment[]
  animalSalesForecasts       AnimalSalesForecast[]
}

model FarmMember {
  id        String   @id @default(cuid())
  farmId    String
  userId    String
  role      FarmRole
  createdAt DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([farmId, userId])
  @@index([userId])
}

model LandHolding {
  id         String    @id @default(cuid())
  farmId     String
  name       String
  owned      Boolean   @default(true)
  costOrRent Decimal?  @db.Decimal(14, 2)
  currency   String    @default("TZS")
  leaseStart DateTime?
  leaseEnd   DateTime?
  ownerName  String?
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  farm        Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plots       Plot[]
  disputes    TenureDispute[]
  attachments FileAttachment[]
}

model Plot {
  id             String         @id @default(cuid())
  farmId         String
  holdingId      String
  name           String
  areaValue      Decimal        @db.Decimal(12, 4)
  areaUnit       String         @default("acre")
  soilType       String?
  waterSource    String?
  gpsLat         Decimal?       @db.Decimal(10, 7)
  gpsLng         Decimal?       @db.Decimal(10, 7)
  tenureType     TenureType     @default(INFORMAL)
  documentStatus DocumentStatus @default(NONE)
  renewalDate    DateTime?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())

  farm         Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  holding      LandHolding         @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  cycles       CropCycle[]
  expenses     Expense[]
  disputes     TenureDispute[]
  attachments  FileAttachment[]
  allocations  ExpenseAllocation[]
  machineJobs  MachineJob[]
  assetUsages  AssetUsage[]
  weatherLogs  WeatherLog[]
  scoutingLogs ScoutingLog[]
  sprayRecords SprayRecord[]
}

model CropType {
  id              String      @id @default(cuid())
  farmId          String
  name            String
  varietyDefault  String?
  mode            CropMode
  cycleLengthDays Int?
  spacingNote     String?
  plantsPerAcre   Decimal?    @db.Decimal(12, 2)
  yieldPerPlant   Decimal?    @db.Decimal(12, 4)
  yieldUnit       String      @default("kg")
  figureLabel     FigureLabel @default(PLACEHOLDER_BENCHMARK)
  sourceDate      DateTime?
  sourceNote      String?
  archivedAt      DateTime?
  createdAt       DateTime    @default(now())

  farm           Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  stageTemplates StageTemplate[]
  careTemplates  CareTemplate[]
  references     CropReferenceItem[]
  cycles         CropCycle[]
  attachments    FileAttachment[]
}

model CropReferenceItem {
  id               String            @id @default(cuid())
  farmId           String
  cropTypeId       String
  kind             CropReferenceKind
  name             String
  activeIngredient String?
  notes            String?
  createdAt        DateTime          @default(now())

  farm     Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropType CropType @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)

  @@unique([farmId, cropTypeId, kind, name])
  @@index([farmId, cropTypeId, kind])
}

model StageTemplate {
  id         String @id @default(cuid())
  farmId     String
  cropTypeId String
  key        String
  nameEn     String
  nameSw     String
  sortOrder  Int
  dayOffset  Int?

  cropType CropType @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)
}

model CareTemplate {
  id            String @id @default(cuid())
  farmId        String
  cropTypeId    String
  taskType      String
  afterStageKey String
  intervalDays  Int
  nameEn        String
  nameSw        String

  cropType CropType @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)
}

model CropCycle {
  id                String      @id @default(cuid())
  farmId            String
  plotId            String
  cropTypeId        String
  variety           String?
  areaValue         Decimal     @db.Decimal(12, 4)
  areaUnit          String      @default("acre")
  plantingAt        DateTime?
  actualStartAt     DateTime?
  expectedHarvestAt DateTime?
  actualHarvestAt   DateTime?
  archivedAt        DateTime?
  status            CycleStatus @default(PLANNED)
  expectedYield     Decimal?    @db.Decimal(14, 4)
  actualYield       Decimal?    @db.Decimal(14, 4)
  yieldUnit         String      @default("kg")
  figureLabel       FigureLabel @default(PLACEHOLDER_BENCHMARK)
  createdAt         DateTime    @default(now())

  farm              Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plot              Plot                @relation(fields: [plotId], references: [id], onDelete: Cascade)
  cropType          CropType            @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)
  batches           NurseryBatch[]
  tasks             Task[]
  logs              ActivityLog[]
  work              WorkEntry[]
  machineJobs       MachineJob[]
  expenses          Expense[]
  allocations       ExpenseAllocation[]
  plans             CropPlan[]
  harvests          Harvest[]
  sales             Sale[]
  assetUsages       AssetUsage[]
  assetMaintenances AssetMaintenance[]
  stockMovements    StockMovement[]
  stageHistory      CropCycleStage[]
  scoutingLogs      ScoutingLog[]
  sprayRecords      SprayRecord[]
  weatherLogs       WeatherLog[]
  attachments       FileAttachment[]

  @@index([farmId, status])
  @@index([plotId, cropTypeId])
}

model NurseryBatch {
  id           String    @id @default(cuid())
  farmId       String
  cycleId      String
  seedLot      String?
  variety      String?
  supplier     String?
  quantity     Decimal   @db.Decimal(14, 4)
  quantityUnit String    @default("g")
  costAmount   Decimal?  @db.Decimal(14, 2)
  currency     String    @default("TZS")
  sownAt       DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  cycle  CropCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  checks NurseryCheck[]
  plants Transplant[]
}

model NurseryCheck {
  id         String   @id @default(cuid())
  farmId     String
  batchId    String
  checkedAt  DateTime @default(now())
  germinated Int?
  surviving  Int?
  condition  String?
  notes      String?
  offlineId  String?  @unique

  batch NurseryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Transplant {
  id                String   @id @default(cuid())
  farmId            String
  batchId           String
  movedAt           DateTime @default(now())
  quantityMoved     Int
  quantityDiscarded Int      @default(0)
  reason            String?

  batch NurseryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Task {
  id         String     @id @default(cuid())
  farmId     String
  cycleId    String
  plotId     String?
  taskType   String
  titleEn    String
  titleSw    String
  dueAt      DateTime
  status     TaskStatus @default(PENDING)
  doneAt     DateTime?
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime   @default(now())

  cycle          CropCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  attachments    FileAttachment[]

  @@index([farmId, dueAt, status])
  @@index([cycleId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  farmId    String
  cycleId   String?
  userId    String?
  loggedAt  DateTime @default(now())
  weather   String?
  body      String
  whoWorked String?
  synced    Boolean  @default(true)
  offlineId String?  @unique

  farm  Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cycle CropCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Worker {
  id         String   @id @default(cuid())
  farmId     String
  name       String
  hourlyRate Decimal? @db.Decimal(12, 2)
  currency   String   @default("TZS")
  active     Boolean  @default(true)
  phone      String?
  createdAt  DateTime @default(now())

  farm    Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  entries WorkEntry[]
}

model WorkEntry {
  id               String         @id @default(cuid())
  farmId           String
  workerId         String
  cycleId          String?
  userId           String?
  taskLabel        String
  startedAt        DateTime
  endedAt          DateTime
  hourlyRate       Decimal        @db.Decimal(12, 2)
  amount           Decimal        @db.Decimal(14, 2)
  currency         String         @default("TZS")
  paid             Boolean        @default(false)
  paymentMethod    PaymentMethod?
  paymentReference String?
  offlineId        String?        @unique
  createdAt        DateTime       @default(now())

  worker Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  cycle  CropCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  user   User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([farmId, cycleId, startedAt])
}

model Expense {
  id        String          @id @default(cuid())
  farmId    String
  cycleId   String?
  plotId    String?
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(14, 2)
  currency  String          @default("TZS")
  spentAt   DateTime        @default(now())
  notes     String?
  offlineId String?         @unique
  createdAt DateTime        @default(now())

  farm        Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cycle       CropCycle?          @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  plot        Plot?               @relation(fields: [plotId], references: [id], onDelete: SetNull)
  allocations ExpenseAllocation[]

  @@index([farmId, cycleId, category])
  @@index([spentAt])
}

model ExpenseAllocation {
  id                String             @id @default(cuid())
  farmId            String
  expenseId         String
  cycleId           String?
  plotId            String?
  animalId          String?
  animalGroupId     String?
  animalProductLine AnimalProductLine?
  amount            Decimal            @db.Decimal(14, 2)
  currency          String             @default("TZS")

  expense     Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  cycle       CropCycle?   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  plot        Plot?        @relation(fields: [plotId], references: [id], onDelete: Cascade)
  animal      Animal?      @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalGroup AnimalGroup? @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)

  @@index([farmId, cycleId])
  @@index([farmId, plotId])
  @@index([farmId, animalId])
  @@index([farmId, animalGroupId])
}

model MachineJob {
  id              String   @id @default(cuid())
  farmId          String
  cycleId         String?
  plotId          String?
  description     String
  hours           Decimal  @db.Decimal(10, 2)
  fuelCost        Decimal  @default(0) @db.Decimal(14, 2)
  hireCost        Decimal  @default(0) @db.Decimal(14, 2)
  maintenanceCost Decimal  @default(0) @db.Decimal(14, 2)
  currency        String   @default("TZS")
  performedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  farm  Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cycle CropCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  plot  Plot?      @relation(fields: [plotId], references: [id], onDelete: SetNull)

  @@index([farmId, cycleId, performedAt])
  @@index([farmId, plotId])
}

model Asset {
  id                  String             @id @default(cuid())
  farmId              String
  name                String
  type                String
  purchasedAt         DateTime?
  purchaseCost        Decimal?           @db.Decimal(14, 2)
  currency            String             @default("TZS")
  expectedLifeMonths  Int?
  isCapitalInvestment Boolean            @default(false)
  division            AssetDivision?
  productLine         AnimalProductLine?
  fundingSource       String?
  salvageValue        Decimal?           @db.Decimal(14, 2)
  status              AssetStatus        @default(ACTIVE)
  notes               String?
  archivedAt          DateTime?
  createdAt           DateTime           @default(now())

  farm         Farm               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  usages       AssetUsage[]
  maintenances AssetMaintenance[]

  @@index([farmId, status])
}

model AssetUsage {
  id           String   @id @default(cuid())
  farmId       String
  assetId      String
  cycleId      String?
  plotId       String?
  usedAt       DateTime @default(now())
  hours        Decimal? @db.Decimal(10, 2)
  distance     Decimal? @db.Decimal(12, 2)
  distanceUnit String?
  operator     String?
  fuelCost     Decimal  @default(0) @db.Decimal(14, 2)
  currency     String   @default("TZS")
  notes        String?
  createdAt    DateTime @default(now())

  farm  Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  asset Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  cycle CropCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  plot  Plot?      @relation(fields: [plotId], references: [id], onDelete: SetNull)

  @@index([farmId, assetId, usedAt])
  @@index([farmId, cycleId, usedAt])
}

model AssetMaintenance {
  id            String    @id @default(cuid())
  farmId        String
  assetId       String
  cycleId       String?
  performedAt   DateTime  @default(now())
  description   String
  cost          Decimal   @default(0) @db.Decimal(14, 2)
  currency      String    @default("TZS")
  nextServiceAt DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  farm  Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  asset Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  cycle CropCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([farmId, assetId, performedAt])
  @@index([farmId, cycleId, performedAt])
}

model CropPlan {
  id              String       @id @default(cuid())
  farmId          String
  cycleId         String
  scenario        PlanScenario @default(EXPECTED)
  areaAcres       Decimal      @db.Decimal(12, 4)
  seedGrams       Decimal?     @db.Decimal(14, 4)
  seedsPerGram    Decimal?     @db.Decimal(14, 4)
  germinationRate Decimal?     @db.Decimal(6, 4)
  survivalRate    Decimal?     @db.Decimal(6, 4)
  plantsPerAcre   Decimal?     @db.Decimal(12, 2)
  yieldPerPlant   Decimal?     @db.Decimal(12, 4)
  yieldUnit       String       @default("kg")
  farmgatePrice   Decimal?     @db.Decimal(14, 2)
  harvestMonth    Int?
  currency        String       @default("TZS")
  figureLabel     FigureLabel  @default(PLACEHOLDER_BENCHMARK)
  notes           String?
  createdAt       DateTime     @default(now())

  cycle CropCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  lines CropPlanLine[]

  @@unique([cycleId, scenario])
}

model CropPlanLine {
  id          String          @id @default(cuid())
  farmId      String
  planId      String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(14, 2)
  currency    String          @default("TZS")
  timingMonth Int?
  figureLabel FigureLabel     @default(PLACEHOLDER_BENCHMARK)

  plan CropPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Harvest {
  id          String   @id @default(cuid())
  farmId      String
  cycleId     String
  harvestedAt DateTime @default(now())
  quantity    Decimal  @db.Decimal(14, 4)
  unit        String   @default("kg")
  grade       String?
  lossQty     Decimal? @db.Decimal(14, 4)
  notes       String?

  cycle CropCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([farmId, cycleId, harvestedAt])
}

model Sale {
  id       String   @id @default(cuid())
  farmId   String
  cycleId  String
  soldAt   DateTime @default(now())
  quantity Decimal  @db.Decimal(14, 4)
  unit     String   @default("kg")
  price    Decimal  @db.Decimal(14, 2)
  currency String   @default("TZS")
  buyer    String?
  notes    String?

  cycle CropCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([farmId, cycleId, soldAt])
}

model AnimalSale {
  id               String            @id @default(cuid())
  farmId           String
  productLine      AnimalProductLine
  animalId         String?
  animalGroupId    String?
  soldAt           DateTime          @default(now())
  quantity         Decimal           @db.Decimal(14, 4)
  unit             String
  price            Decimal           @db.Decimal(14, 2)
  totalAmount      Decimal           @db.Decimal(14, 2)
  amountReceived   Decimal           @default(0) @db.Decimal(14, 2)
  paymentMethod    PaymentMethod?
  paymentReference String?
  currency         String            @default("TZS")
  buyer            String?
  notes            String?
  createdAt        DateTime          @default(now())

  farm        Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal      Animal?             @relation(fields: [animalId], references: [id], onDelete: SetNull)
  animalGroup AnimalGroup?        @relation(fields: [animalGroupId], references: [id], onDelete: SetNull)
  payments    AnimalSalePayment[]

  @@index([farmId, productLine, soldAt])
  @@index([farmId, animalId, soldAt])
  @@index([farmId, animalGroupId, soldAt])
}

model AnimalSalePayment {
  id            String         @id @default(cuid())
  farmId        String
  animalSaleId  String
  amount        Decimal        @db.Decimal(14, 2)
  receivedAt    DateTime       @default(now())
  paymentMethod PaymentMethod?
  reference     String?
  notes         String?
  createdAt     DateTime       @default(now())

  farm       Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animalSale AnimalSale @relation(fields: [animalSaleId], references: [id], onDelete: Cascade)

  @@index([farmId, receivedAt])
  @@index([farmId, animalSaleId, receivedAt])
}

model AnimalSalesForecast {
  id          String            @id @default(cuid())
  farmId      String
  productLine AnimalProductLine
  plannedFor  DateTime
  quantity    Decimal           @db.Decimal(14, 4)
  unit        String
  unitPrice   Decimal?          @db.Decimal(14, 2)
  currency    String            @default("TZS")
  notes       String?
  createdAt   DateTime          @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, plannedFor])
  @@index([farmId, productLine, plannedFor])
}

model StockItem {
  id                  String          @id @default(cuid())
  farmId              String
  name                String
  category            ExpenseCategory
  unit                String
  lowStockThreshold   Decimal?        @db.Decimal(14, 4)
  crudeProteinPct     Decimal?        @db.Decimal(8, 4)
  crudeFiberPct       Decimal?        @db.Decimal(8, 4)
  energyValue         Decimal?        @db.Decimal(14, 4)
  energyUnit          String?
  qualityNotes        String?
  storageInstructions String?
  shelfLifeDays       Int?
  openedLifeDays      Int?
  createdAt           DateTime        @default(now())

  farm                     Farm                      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  movements                StockMovement[]
  feedRations              FeedRation[]
  animalDailyRecords       AnimalDailyRecord[]
  animalPerformanceRecords AnimalPerformanceRecord[]
  healthProducts           AnimalHealthProduct[]

  @@unique([farmId, name])
}

model Supplier {
  id        String   @id @default(cuid())
  farmId    String
  name      String
  contact   String?
  createdAt DateTime @default(now())

  farm      Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@unique([farmId, name])
}

model StockMovement {
  id                   String            @id @default(cuid())
  farmId               String
  itemId               String
  supplierId           String?
  cycleId              String?
  animalId             String?
  animalGroupId        String?
  taskId               String?
  animalHealthRecordId String?
  type                 StockMovementType
  quantity             Decimal           @db.Decimal(14, 4)
  unit                 String
  unitCost             Decimal?          @db.Decimal(14, 4)
  currency             String            @default("TZS")
  lotReference         String?
  movedAt              DateTime          @default(now())
  notes                String?

  farm               Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  item               StockItem           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  cycle              CropCycle?          @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  animal             Animal?             @relation(fields: [animalId], references: [id], onDelete: SetNull)
  animalGroup        AnimalGroup?        @relation(fields: [animalGroupId], references: [id], onDelete: SetNull)
  task               Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  animalHealthRecord AnimalHealthRecord? @relation(fields: [animalHealthRecordId], references: [id], onDelete: SetNull)

  @@index([farmId, itemId, movedAt])
  @@index([farmId, cycleId, type])
  @@index([farmId, animalId, movedAt])
  @@index([farmId, animalGroupId, movedAt])
  @@index([farmId, animalHealthRecordId])
}

model Animal {
  id               String    @id @default(cuid())
  farmId           String
  tagNumber        String
  name             String?
  species          String
  breed            String?
  breedId          String?
  sex              String?
  birthDate        DateTime?
  damId            String?
  sireId           String?
  breedingRecordId String?
  source           String?
  purchasePrice    Decimal?  @db.Decimal(14, 2)
  seller           String?
  groupId          String?
  status           String    @default("ACTIVE")
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())

  farm               Farm                      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  group              AnimalGroup?              @relation(fields: [groupId], references: [id], onDelete: SetNull)
  breedReference     AnimalBreed?              @relation(fields: [breedId], references: [id], onDelete: SetNull)
  dam                Animal?                   @relation("AnimalDam", fields: [damId], references: [id], onDelete: SetNull)
  offspringAsDam     Animal[]                  @relation("AnimalDam")
  sire               Animal?                   @relation("AnimalSire", fields: [sireId], references: [id], onDelete: SetNull)
  offspringAsSire    Animal[]                  @relation("AnimalSire")
  breedingRecord     AnimalBreedingRecord?     @relation(fields: [breedingRecordId], references: [id], onDelete: SetNull)
  events             AnimalEvent[]
  dailyRecords       AnimalDailyRecord[]
  expenseAllocations ExpenseAllocation[]
  stockMovements     StockMovement[]
  healthCases        AnimalHealthCase[]
  healthRecords      AnimalHealthRecord[]
  performanceRecords AnimalPerformanceRecord[]
  traitRecords       AnimalTraitRecord[]
  sales              AnimalSale[]
  breedingAsDam      AnimalBreedingRecord[]    @relation("BreedingDam")
  breedingAsSire     AnimalBreedingRecord[]    @relation("BreedingSire")

  @@unique([farmId, tagNumber])
  @@index([farmId, species, status])
  @@index([farmId, groupId])
  @@index([farmId, damId])
  @@index([farmId, sireId])
  @@index([farmId, breedId])
  @@index([farmId, breedingRecordId])
}

model AnimalSpeciesProfile {
  id            String       @id @default(cuid())
  farmId        String
  species       String
  gestationDays Int?
  sourceLabel   FigureLabel?
  sourceDate    DateTime?
  sourceNote    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([farmId, species])
}

model AnimalBreed {
  id         String        @id @default(cuid())
  farmId     String
  species    String
  name       String
  purpose    AnimalPurpose
  archivedAt DateTime?
  createdAt  DateTime      @default(now())

  farm       Farm                   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animals    Animal[]
  benchmarks AnimalBreedBenchmark[]

  @@unique([farmId, species, name])
  @@index([farmId, species, archivedAt])
}

model AnimalBreedBenchmark {
  id          String      @id @default(cuid())
  farmId      String
  breedId     String
  traitName   String
  value       String
  unit        String?
  sourceLabel FigureLabel
  sourceDate  DateTime
  sourceNote  String
  createdAt   DateTime    @default(now())

  farm  Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  breed AnimalBreed @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@index([farmId, breedId, traitName])
}

model AnimalGroup {
  id            String             @id @default(cuid())
  farmId        String
  name          String
  species       String
  trackingMode  AnimalTrackingMode @default(HEAD_COUNT)
  startDate     DateTime           @default(now())
  startingCount Int
  notes         String?
  archivedAt    DateTime?
  createdAt     DateTime           @default(now())

  farm                       Farm                        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animals                    Animal[]
  events                     AnimalEvent[]
  dailyRecords               AnimalDailyRecord[]
  feedRations                FeedRation[]
  expenseAllocations         ExpenseAllocation[]
  stockMovements             StockMovement[]
  healthCases                AnimalHealthCase[]
  healthRecords              AnimalHealthRecord[]
  performanceRecords         AnimalPerformanceRecord[]
  animalVaccinationSchedules AnimalVaccinationSchedule[]
  sales                      AnimalSale[]

  @@unique([farmId, name])
  @@index([farmId, species, startDate])
}

model AnimalEvent {
  id            String          @id @default(cuid())
  farmId        String
  animalId      String?
  animalGroupId String?
  type          AnimalEventType
  occurredAt    DateTime        @default(now())
  quantity      Int?
  purchaseCost  Decimal?        @db.Decimal(14, 2)
  seller        String?
  notes         String?
  createdAt     DateTime        @default(now())

  farm        Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal      Animal?      @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalGroup AnimalGroup? @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)

  @@index([farmId, animalId, occurredAt])
  @@index([farmId, animalGroupId, occurredAt])
}

model AnimalDailyRecord {
  id            String                @id @default(cuid())
  farmId        String
  animalId      String?
  animalGroupId String?
  feedItemId    String?
  type          AnimalDailyRecordType
  recordedAt    DateTime              @default(now())
  quantity      Decimal?              @db.Decimal(14, 4)
  unit          String?
  notes         String?
  offlineId     String?               @unique
  createdAt     DateTime              @default(now())

  farm        Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal      Animal?      @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalGroup AnimalGroup? @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)
  feedItem    StockItem?   @relation(fields: [feedItemId], references: [id], onDelete: SetNull)

  @@index([farmId, recordedAt])
  @@index([farmId, animalId, recordedAt])
  @@index([farmId, animalGroupId, recordedAt])
}

model FeedRation {
  id              String   @id @default(cuid())
  farmId          String
  animalGroupId   String
  itemId          String
  quantityPerHead Decimal  @db.Decimal(14, 4)
  unit            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  farm        Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animalGroup AnimalGroup @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)
  item        StockItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([farmId, animalGroupId, itemId])
  @@index([farmId, animalGroupId])
}

model AnimalHealthProduct {
  id             String                  @id @default(cuid())
  farmId         String
  name           String
  type           AnimalHealthProductType
  stockItemId    String?
  diseaseCovered String?
  dose           String?
  route          String?
  storage        String?
  batch          String?
  expiresAt      DateTime?
  costPerDose    Decimal?                @db.Decimal(14, 4)
  withdrawalDays Int                     @default(0)
  archivedAt     DateTime?
  createdAt      DateTime                @default(now())

  farm      Farm                        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  stockItem StockItem?                  @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  schedules AnimalVaccinationSchedule[]
  records   AnimalHealthRecord[]

  @@index([farmId, type, archivedAt])
}

model AnimalVaccinationSchedule {
  id              String    @id @default(cuid())
  farmId          String
  productId       String
  title           String
  species         String
  breed           String?
  animalGroupId   String?
  ageDays         Int?
  firstDueAt      DateTime?
  repeatEveryDays Int?
  notes           String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())

  farm        Farm                 @relation(fields: [farmId], references: [id], onDelete: Cascade)
  product     AnimalHealthProduct  @relation(fields: [productId], references: [id], onDelete: Restrict)
  animalGroup AnimalGroup?         @relation(fields: [animalGroupId], references: [id], onDelete: SetNull)
  records     AnimalHealthRecord[]

  @@index([farmId, species, breed, archivedAt])
  @@index([farmId, animalGroupId])
}

model AnimalHealthCase {
  id            String    @id @default(cuid())
  farmId        String
  animalId      String?
  animalGroupId String?
  symptoms      String
  diagnosis     String?
  diagnosedBy   String?
  outcome       String?
  openedAt      DateTime  @default(now())
  resolvedAt    DateTime?
  offlineId     String?   @unique
  createdAt     DateTime  @default(now())

  farm        Farm                 @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal      Animal?              @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalGroup AnimalGroup?         @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)
  records     AnimalHealthRecord[]

  @@index([farmId, openedAt, resolvedAt])
  @@index([farmId, animalId, openedAt])
  @@index([farmId, animalGroupId, openedAt])
}

model AnimalHealthRecord {
  id              String                 @id @default(cuid())
  farmId          String
  animalId        String?
  animalGroupId   String?
  healthCaseId    String?
  productId       String?
  scheduleId      String?
  type            AnimalHealthRecordType
  administeredAt  DateTime               @default(now())
  dose            String?
  route           String?
  batch           String?
  cost            Decimal?               @db.Decimal(14, 2)
  withdrawalDays  Int                    @default(0)
  withdrawalUntil DateTime?
  notes           String?
  offlineId       String?                @unique
  createdAt       DateTime               @default(now())

  farm           Farm                       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal         Animal?                    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalGroup    AnimalGroup?               @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)
  healthCase     AnimalHealthCase?          @relation(fields: [healthCaseId], references: [id], onDelete: SetNull)
  product        AnimalHealthProduct?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  schedule       AnimalVaccinationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]

  @@index([farmId, animalId, administeredAt])
  @@index([farmId, animalGroupId, administeredAt])
  @@index([farmId, withdrawalUntil])
}

model AnimalPerformanceRecord {
  id            String                @id @default(cuid())
  farmId        String
  animalId      String?
  animalGroupId String?
  feedItemId    String?
  type          AnimalPerformanceType
  quantity      Decimal               @db.Decimal(14, 4)
  unit          String
  recordedAt    DateTime              @default(now())
  notes         String?
  offlineId     String?               @unique
  createdAt     DateTime              @default(now())

  farm        Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal      Animal?      @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalGroup AnimalGroup? @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)
  feedItem    StockItem?   @relation(fields: [feedItemId], references: [id], onDelete: SetNull)

  @@index([farmId, type, recordedAt])
  @@index([farmId, animalId, recordedAt])
  @@index([farmId, animalGroupId, recordedAt])
  @@index([farmId, feedItemId, recordedAt])
}

model AnimalTraitRecord {
  id           String          @id @default(cuid())
  farmId       String
  animalId     String
  type         AnimalTraitType
  textValue    String?
  numericValue Decimal?        @db.Decimal(14, 4)
  unit         String?
  recordedAt   DateTime        @default(now())
  notes        String?
  offlineId    String?         @unique
  createdAt    DateTime        @default(now())

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([farmId, animalId, type, recordedAt])
}

model AnimalBreedingRecord {
  id                 String                 @id @default(cuid())
  farmId             String
  damId              String
  sireId             String?
  semenBatch         String?
  method             AnimalBreedingMethod
  servedAt           DateTime
  expectedBirthAt    DateTime?
  pregnancyCheckedAt DateTime?
  pregnancyResult    AnimalPregnancyResult?
  birthAt            DateTime?
  birthOutcome       AnimalBirthOutcome?
  notes              String?
  offlineId          String?                @unique
  createdAt          DateTime               @default(now())

  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  dam       Animal   @relation("BreedingDam", fields: [damId], references: [id], onDelete: Cascade)
  sire      Animal?  @relation("BreedingSire", fields: [sireId], references: [id], onDelete: SetNull)
  offspring Animal[]

  @@index([farmId, servedAt])
  @@index([farmId, damId, servedAt])
  @@index([farmId, sireId, servedAt])
  @@index([farmId, expectedBirthAt])
}

model ConsentRecord {
  id             String    @id @default(cuid())
  farmId         String
  userId         String
  purpose        String
  policyVersion  String
  granted        Boolean
  recordedAt     DateTime  @default(now())
  withdrawnAt    DateTime?
  sharedWith     String?
  scope          String?
  expiresAt      DateTime?
  retentionUntil DateTime?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([farmId, userId, purpose, recordedAt])
}

model DataRequest {
  id            String            @id @default(cuid())
  farmId        String
  userId        String
  subjectUserId String?
  type          DataRequestType
  scope         DataRequestScope?
  status        DataRequestStatus @default(REQUESTED)
  requestedAt   DateTime          @default(now())
  completedAt   DateTime?
  notes         String?

  farm    Farm  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject User? @relation("DataRequestSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([farmId, userId, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  farmId      String
  actorUserId String?
  action      String
  entity      String
  recordId    String?
  occurredAt  DateTime @default(now())

  farm  Farm  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([farmId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model FarmInvitation {
  id           String    @id @default(cuid())
  farmId       String
  invitedEmail String
  tokenHash    String    @unique
  createdById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  farm      Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  createdBy User @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([farmId, invitedEmail, expiresAt])
}

model TenureDispute {
  id          String   @id @default(cuid())
  farmId      String
  holdingId   String?
  plotId      String?
  occurredAt  DateTime @default(now())
  description String
  status      String   @default("OPEN")
  resolution  String?
  createdAt   DateTime @default(now())

  farm    Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  holding LandHolding? @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  plot    Plot?        @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@index([farmId, status, occurredAt])
}

model FileAttachment {
  id            String   @id @default(cuid())
  farmId        String
  landHoldingId String?
  plotId        String?
  cropTypeId    String?
  cycleId       String?
  taskId        String?
  filename      String
  storageKey    String   @unique
  mimeType      String
  sizeBytes     Int
  createdById   String
  createdAt     DateTime @default(now())

  farm     Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  holding  LandHolding? @relation(fields: [landHoldingId], references: [id], onDelete: Cascade)
  plot     Plot?        @relation(fields: [plotId], references: [id], onDelete: Cascade)
  cropType CropType?    @relation(fields: [cropTypeId], references: [id], onDelete: Cascade)
  cycle    CropCycle?   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  task     Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([farmId, createdAt])
}

model WeatherLog {
  id           String   @id @default(cuid())
  farmId       String
  plotId       String
  cycleId      String?
  observedAt   DateTime @default(now())
  rainfallMm   Decimal? @db.Decimal(10, 2)
  temperatureC Decimal? @db.Decimal(6, 2)
  notes        String?
  offlineId    String?  @unique

  farm  Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plot  Plot       @relation(fields: [plotId], references: [id], onDelete: Cascade)
  cycle CropCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([farmId, plotId, observedAt])
}

model ScoutingLog {
  id         String           @id @default(cuid())
  farmId     String
  plotId     String
  cycleId    String?
  observedAt DateTime         @default(now())
  issue      String
  severity   ScoutingSeverity
  notes      String?
  offlineId  String?          @unique

  farm  Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plot  Plot       @relation(fields: [plotId], references: [id], onDelete: Cascade)
  cycle CropCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([farmId, plotId, observedAt])
}

model SprayRecord {
  id                     String   @id @default(cuid())
  farmId                 String
  plotId                 String
  cycleId                String?
  product                String
  activeIngredient       String?
  batch                  String?
  dose                   String?
  appliedAt              DateTime @default(now())
  preHarvestIntervalDays Int?
  notes                  String?
  offlineId              String?  @unique

  farm  Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plot  Plot       @relation(fields: [plotId], references: [id], onDelete: Cascade)
  cycle CropCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([farmId, plotId, appliedAt])
  @@index([cycleId, appliedAt])
}

model CropCycleStage {
  id          String    @id @default(cuid())
  farmId      String
  cycleId     String
  stageKey    String
  nameEn      String
  nameSw      String
  startedAt   DateTime
  expectedAt  DateTime?
  completedAt DateTime?

  cycle CropCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([farmId, cycleId, startedAt])
}

model SubsidyReceipt {
  id         String   @id @default(cuid())
  farmId     String
  input      String
  quantity   Decimal  @db.Decimal(14, 4)
  unit       String
  price      Decimal? @db.Decimal(14, 2)
  currency   String   @default("TZS")
  receivedAt DateTime @default(now())
  source     String?
  notes      String?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, receivedAt])
}
